# ===== Model (your own AI) =====
# ollama = local open model on your machine/server, gemini = Google API
LLM_PROVIDER=ollama
# If the primary fails, try this one (delete the line to disable)
LLM_FALLBACK=gemini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# How many model calls may run at once (extra requests wait in a queue)
MAX_CONCURRENT_LLM=4

# ===== Web research + lead discovery (pick ONE search provider) =====
TAVILY_API_KEY=
BRAVE_API_KEY=
CRAWLER_USER_AGENT=KRAIPBot/0.1 (+https://yourdomain.com/bot)

# ===== Phone calls =====
# PUBLIC_URL = the https address your phone provider can reach (use ngrok while testing)
PUBLIC_URL=
# plivo (cheap, India) or twilio. Blank = Plivo if its keys are set, else Twilio
PHONE_PROVIDER=plivo

# --- Plivo (calls) ---
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# --- Sarvam AI (listens + speaks on Plivo calls, built for Indian languages) ---
SARVAM_API_KEY=
SARVAM_SPEAKER=priya
SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_TTS_CODEC=linear16        # change to mp3 only if Sarvam refuses linear16 (needs ffmpeg installed)
# Optional: secret used to sign webhook links. Blank = derived from your Plivo token
# WEBHOOK_SECRET=
# Optional: hang up when a call reaches voicemail instead of paying to talk to a machine
# PLIVO_MACHINE_DETECTION=hangup
# Max length of any one call, in seconds (cost safety)
MAX_CALL_SECONDS=900
# Wait this long after the caller stops talking before answering (milliseconds)
VOICE_DEBOUNCE_MS=700
# Ask "are you still there?" after this much silence (milliseconds), hang up after a second silence
VOICE_IDLE_MS=9000
# 0 = caller cannot interrupt the AI
VOICE_BARGE_IN=1

# --- Twilio (alternative, uses Twilio's own speech engine, costs more) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Outbound campaigns
CALL_TIMEZONE=Asia/Kolkata
RETRY_MINUTES=120
CAMPAIGN_CALLS_PER_TICK=2
DEFAULT_COUNTRY_CODE=91

# ===== Billing (prices in INR) =====
RATE_PER_MINUTE_INR=3.5          # normal call minutes
RATE_PER_LEAD_MINUTE_INR=5       # minutes of calls that produced a hot/warm lead
RATE_PER_LEAD_INR=0              # optional extra flat fee per qualified lead
RATE_PER_RESEARCH_INR=2
RATE_PER_MESSAGE_INR=0
# Your own estimated costs, used only for the margin view in the Billing tab (paise)
COST_TELEPHONY_PAISE_PER_MIN=38      # Plivo
COST_STT_PAISE_PER_SEC=0.83          # Sarvam speech-to-text (about Rs 30/hour)
COST_TTS_PAISE_PER_CHAR=0.3          # Sarvam text-to-speech (about Rs 30 per 10,000 characters)
COST_LLM_PAISE_PER_TURN=10           # your language model; 0 if self-hosted
# Razorpay payment links. Webhook URL to set in Razorpay: {PUBLIC_URL}/webhooks/razorpay  (event: payment_link.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ===== Safety limits =====
# Most unpaid usage (INR) a business may run up before new calls/campaigns are refused. Blank or 0 = no limit.
CREDIT_LIMIT_INR=
# Seconds to wait for the language model before giving up (a hung model must not hang a live call)
LLM_TIMEOUT_MS=30000
# Per-user limit for endpoints that cost money (model calls, search, crawling), per minute
COSTLY_PER_MINUTE=30
# Messages one anonymous website-chat conversation may send
MAX_PUBLIC_MESSAGES=80
# Wrong-password attempts per account per 15 minutes
LOGIN_ATTEMPTS_PER_15MIN=10
# Number of reverse proxies in front of KRAIP (1 = nginx/ngrok/Render etc.). Set 0 if KRAIP is exposed directly.
TRUST_PROXY=1
# How often campaigns check for contacts to call (milliseconds)
CAMPAIGN_TICK_MS=60000

# ---- Wallet, pricing, alerts, retention ----
# postpaid = invoice monthly (CREDIT_LIMIT_INR caps exposure); prepaid = customer tops up a wallet, calls stop at zero balance
BILLING_MODE=postpaid
# Comma-separated login emails allowed to set per-business pricing and adjust wallets
ADMIN_EMAILS=
# Warn the business when its balance falls below this (INR)
LOW_BALANCE_INR=200
# Optional URL that receives low-balance / limit notifications as JSON
ALERT_WEBHOOK_URL=
# Allowed wallet top-up range (INR)
TOPUP_MIN_INR=100
TOPUP_MAX_INR=50000
# Optional fee per lead found by AI research (INR, 0 = not charged)
RATE_PER_DISCOVERED_LEAD_INR=0
# Redact conversation text older than this many days (billing records are kept). Empty = keep.
RETENTION_DAYS=

PORT=3000
